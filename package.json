{
  "name": "gogochinatrips",
  "version": "0.1.0",
  "private": true,
  "description": "GoGoChinaTrips — China, without the guesswork. Curated small-group tours, private journeys and local experiences for international travelers.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-placeholders.mjs && node scripts/scan-photos.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:images": "node scripts/gen-placeholders.mjs",
    "photos": "node scripts/scan-photos.mjs",
    "fetch:images": "node scripts/fetch-photos.mjs",
    "build:photos": "node scripts/fetch-photos.mjs && next build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.456.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
